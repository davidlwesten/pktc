// Exercises syntax not used by TFTP: length fields, sized arrays, padding,
// bitfields, signed, constant and reserved fields, const declarations and max.
const PORT = 5351;

message Header max 64 {
    version: u8;
    r: u1 = 0;
    opcode: u7;
    skew: i8;
    _: u24;
    rest: PcpOption[..];
}

struct PcpOption {
    code: u8;
    reserved: u8;
    len: u16;
    data: u8[len] pad 4;
}
